// ---------- Завдання 2: Integer17 ----------
bool in_num(int &pNum) {
    cout << "Введіть ціле число більше 999: ";
    cin >> pNum;

    // Повертаємо true, якщо сталася помилка вводу або число не відповідає умові (> 999)
    if (cin.fail() || pNum <= 999) {
        return true; // помилка
    } else {
        return false; // дані коректні
    }
}

int calc_hundreds(int pNum) {
    // Одна операція цілочисельного ділення і одна операція взяття залишку
    return (pNum / 100) % 10;
}

void out_res(int pr) {
    cout << "Цифра, що відповідає розряду сотень: " << pr << endl;
}

void task_int17() {
    int number; // декларація змінної
    cout << "\n************* Integer 17 *****************" << endl;

    // Введення даних з перевіркою
    if (in_num(number)) {
        cout << "Помилка! Потрібно ввести ціле число, більше за 999." << endl;
    } else {
        // Підрахунок і виведення результату
        out_res(calc_hundreds(number));
    }
}
