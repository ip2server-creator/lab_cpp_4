// ---------- Завдання 1.1: Proc10 ----------
void Swap(double &X, double &Y) {
    double temp = X; // зберігаємо значення X у тимчасову змінну
    X = Y;           // записуємо в X значення Y
    Y = temp;        // записуємо в Y збережене значення X
}

void task_proc10() {
    double A, B, C, D;
    cout << "\n************* Proc 10 *****************" << endl;
    cout << "Введіть чотири дійсних числа A, B, C, D (у діапазоні [-100, 100]): ";
    cin >> A >> B >> C >> D;

    // Перевірка на тип даних та приналежність діапазону [-100, 100]
    if (cin.fail() || A < -100 || A > 100 || B < -100 || B > 100 ||
        C < -100 || C > 100 || D < -100 || D > 100) {
        cout << "Помилка! Введіть коректні числа в діапазоні [-100, 100]." << endl;
        return;
    }

    // Послідовний обмін пар: A і B, C і D, B і C
    Swap(A, B);
    Swap(C, D);
    Swap(B, C);

    cout << "Нові значення після обміну:" << endl;
    cout << "A = " << A << ", B = " << B << ", C = " << C << ", D = " << D << endl;
}

// ---------- Завдання 1.2: Proc43 ----------
bool IsTriangle(double a, double b, double c) {
    // Трикутник існує, якщо всі сторони додатні і сума будь-яких двох більша за третю
    if (a > 0 && b > 0 && c > 0 && (a + b > c) && (a + c > b) && (b + c > a)) {
        return true;
    } else {
        return false;
    }
}

